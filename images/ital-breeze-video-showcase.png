e\":{\"enabled\":false},\"is_device_based\":true,\"group_name\":\"Test\",\"is_experiment_active\":true,\"is_user_in_experiment\":true},\"730493191\":{\"name\":\"730493191\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"1584773534\",\"gateValue\":\"false\",\"ruleID\":\"0EJsCp3GoICPEDkX4u1bn\"}],\"version\":14,\"id_type\":\"userID\",\"value\":{\"kind\":\"social\",\"enabled\":true,\"loginStrategy\":\"existing_user\",\"tempDisabled\":false,\"name\":\"apple\"},\"is_device_based\":false,\"passed\":false},\"1977158438\":{\"name\":\"1977158438\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":3,\"id_type\":\"userID\",\"value\":{\"system_prompt\":\"The user is asking about an ad shown to them by {advertiser}. Your response must be about the ad shown. They are using the \\\"Ask ChatGPT\\\" feature to get ChatGPT's honest opinion on the product(s) in the advertisement, and in which situations it could be a great fit for them. You should be honest about when you think the product(s) would vs. would not be useful for the user, based on what you know about them.\\n\\nInformation about the ad:\\n{ad}.\\n\\nStructure your response in the following manner:\\n- Briefly describe the type of user, use case, or situation where this ad/product makes sense for the user.\\n- If appropriate, explain any mismatches with the user's stated preferences or goals. That is, where might it fall short for the user (if appropriate)? You don't have to do this for every query, but feel free to list limitations if you think they're pretty relevant.\\n- Give a concise recommendation (e.g., \\\"worth considering,\\\" \\\"probably not ideal,\\\" \\\"good budget option,\\\" \\\"seriously may be a fit,\\\" etc.)\\n\\nGuidelines:\\n- Be honest and practical.\\n- Do not blindly promote the ad.\\n- Avoid harsh or absolute negative language.\\n- Do not invent details not present in the ad.\\n- Focus on fit, not feature lists.\\n- If the mark on relevance is clearly missed, feel free to be funny with it and keep it lighthearted. Do not mock the user or advertiser; keep the humor gentle.\\n\\nKeep it concise, direct, and easy to scan.\\n\\n{conversation}\",\"user_prompt_key\":\"good_option\",\"enable_web_search\":false},\"is_device_based\":false,\"passed\":false},\"1623104352\":{\"name\":\"1623104352\",\"rule_id\":\"prestart\",\"secondary_exposures\":[],\"version\":25,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"619645130\":{\"name\":\"619645130\",\"rule_id\":\"disabled\",\"secondary_exposures\":[],\"version\":12,\"id_type\":\"userID\",\"value\":{\"max_impressions\":-1,\"one_impression_per_day\":false,\"max_days_visible\":-1},\"is_device_based\":false,\"passed\":false},\"2801269291\":{\"name\":\"2801269291\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":8,\"id_type\":\"userID\",\"value\":{\"apps\":[\"asdk_app_693ca6ce2db08191bb52d66743c65184\",\"connector_76869538009648d5b282a4bb21c3d157\",\"asdk_app_69377d07cd9c8191a988f06f15b8c674\",\"connector_5f3c8c41a1e54ad7a76272c89e2554fa\",\"connector_692de805e3ec8191834719067174a384\",\"connector_68df33b1a2d081918778431a9cfca8ba\",\"connector_69312da8e4dc81919370cb86fd172b6c\",\"connector_68d579f7b0948191a7da3124a3b560f7\"]},\"is_device_based\":false,\"passed\":false},\"1001765573\":{\"name\":\"1001765573\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"4113286138\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"1829150232\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":1041,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"passed\":false},\"2889497622\":{\"name\":\"2889497622\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":18,\"id_type\":\"userID\",\"value\":{\"requested_model_slugs\":[\"gpt-5-5-pro\",\"gpt-5-5-thinking\",\"gpt-5-6-pro\"],\"enabled\":true},\"is_device_based\":false,\"passed\":false},\"1521940286\":{\"name\":\"152194